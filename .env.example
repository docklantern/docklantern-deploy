# Example ONLY. Replace the hostname in your untracked .env file.
# Do not include https:// or a trailing slash.
DOCKLANTERN_DOMAIN=docklantern.example.com
DOCKLANTERN_ADMIN_USERNAME=admin

# Optional project registration (used only with compose.projects.yaml).
# Replace with ABSOLUTE directories where those Compose projects live on your host.
HELLO_PY_PROJECT_DIR=/srv/apps/hello-py
HELLO_JS_PROJECT_DIR=/srv/apps/hello-js
